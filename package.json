{
  "name": "yak-display",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "backendApiVersion": "0.94.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "format": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "generate-client": "openapi-ts && node scripts/write-schema-hash.mjs"
  },
  "dependencies": {
    "axios": "1.19.0",
    "lodash": "4.18.1",
    "pinia": "4.0.2",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tsconfig/node24": "24.0.4",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "npm-run-all2": "9.0.3",
    "typescript": "~6.0.0",
    "vite": "8.2.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-tsc": "3.3.9"
  }
}
