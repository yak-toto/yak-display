{
  "name": "yak-display",
  "version": "0.21.7",
  "private": true,
  "type": "module",
  "backendApiVersion": "0.94.12",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "format": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "generate-client": "openapi-ts && node scripts/write-schema-hash.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "axios": "1.21.0",
    "lodash": "4.18.1",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@tsconfig/node24": "24.0.5",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "npm-run-all2": "9.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-tsc": "3.3.13"
  }
}
