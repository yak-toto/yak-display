{
  "name": "yak-display",
  "version": "0.23.2",
  "private": true,
  "type": "module",
  "backendApiVersion": "0.94.23",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "format": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings .",
    "generate-client": "openapi-ts && bun scripts/write-schema-hash.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "axios": "1.21.0",
    "lodash": "4.18.1",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@tsconfig/node26": "26.0.1",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-tsc": "3.3.14"
  }
}
